---
import { services } from "../data/content";
---

<section id="services" class="border-t border-rule">
  <div class="mx-auto max-w-5xl px-6 py-20 sm:py-28">
    <div class="max-w-xl">
      <p class="font-serif text-lg italic text-ink-soft">I focus on one thing</p>
      <h2 class="mt-2 font-serif text-3xl font-medium text-ink sm:text-4xl">
        Content services
      </h2>
    </div>
    <div class="mt-12 grid gap-10 sm:grid-cols-3 sm:gap-8">
      {
        services.map((service) => (
          <div class="border-t border-rule pt-5">
            <h3 class="font-serif text-xl font-medium text-ink">{service.title}</h3>
            <p class="mt-3 leading-relaxed text-ink-soft">{service.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
