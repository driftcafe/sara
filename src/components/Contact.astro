---
import { contact } from "../data/content";
---

<section id="contact" class="border-t border-rule">
  <div class="mx-auto max-w-3xl px-6 py-20 text-center sm:py-28">
    <p class="font-serif text-lg italic text-ink-soft">{contact.eyebrow}</p>
    <h2 class="mt-2 font-serif text-3xl font-medium text-ink sm:text-4xl">
      {contact.heading}
    </h2>
    <p class="mt-6 leading-relaxed text-ink-soft">
      Have a writing, editing, or proofreading project in mind? Send me a note and
      let's talk about it.
    </p>
    <a
      href={`mailto:${contact.email}`}
      class="mt-8 inline-block border-b border-accent pb-1 font-serif text-xl text-accent hover:text-ink hover:border-ink"
    >
      {contact.email}
    </a>
  </div>
</section>
