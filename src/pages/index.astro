---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import WorkSamples from "../components/WorkSamples.astro";
import BooksProofread from "../components/BooksProofread.astro";
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Sara Peterson | Freelance Writer, Editor & Proofreader"
  description="Sara Peterson is a freelance copywriter, editor, and proofreader specializing in web content, brochures, articles, and books."
>
  <div id="top">
    <Header />
    <main>
      <Hero />
      <Services />
      <WorkSamples />
      <BooksProofread />
      <About />
      <Contact />
    </main>
    <Footer />
  </div>
</Layout>
